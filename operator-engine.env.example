# One or both: pulsechain,robinhood
SWITCH_NETWORKS=pulsechain

# Public mode uses the curated, preflight-checked RPC pool built into 1.1.0.
PULSECHAIN_RPC_MODE=public
PULSECHAIN_RPC_URLS=
PULSECHAIN_TX_RPC_URL=
PULSECHAIN_ADAPTERS=

ROBINHOOD_RPC_MODE=public
ROBINHOOD_RPC_URLS=
ROBINHOOD_TX_RPC_URL=
ROBINHOOD_ADAPTERS=

# Private-node example for a node listening on the Docker host:
# PULSECHAIN_RPC_MODE=private
# PULSECHAIN_RPC_URLS=http://host.docker.internal:8546
